---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const philosophers = await getCollection('philosophers', ({ data }) => !data.draft);
  return philosophers.map(p => ({
    params: { slug: p.id },
    props: { entry: p },
  }));
}

const { entry } = Astro.props;
const renderedContent = entry.rendered?.html || entry.body || '';
const { data } = entry;
---

<BaseLayout title={`${data.philosopher} · TFIS`} description={data.summary} page="philosophers" ogType="article" ogTitle={`${data.philosopher} on the Meaning of Life`} ogDescription={data.summary}>
  <section class="philosopher-hero">
    <div class="container">
      <p class="num-stamp">
        <a href="/philosophers/" style="color:var(--g400);text-decoration:none">← All Philosophers</a>
      </p>
      <h1>{data.philosopher}</h1>
      <p class="philosopher-era">{data.era}</p>
      <p class="philosopher-summary">{data.summary}</p>
    </div>
  </section>
  <section class="philosopher-content">
    <div class="container">
      <Fragment set:html={renderedContent} />
      <div style="margin-top:40px;padding-top:24px;border-top:1px solid var(--g200)">
        <a href="/philosophers/" class="btn btn--ghost btn--small">← Back to all philosophers</a>
      </div>
    </div>
  </section>
</BaseLayout>
