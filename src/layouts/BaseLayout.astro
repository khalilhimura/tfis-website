---
export interface Props {
  title: string;
  description: string;
  page: 'home' | 'functional-life' | 'meaning-of-life' | 'philosophers' | 'writing' | 'writing-post' | '404';
  ogType?: 'website' | 'article';
  ogTitle?: string;
  ogDescription?: string;
}

const { title, description, page, ogType = 'website', ogTitle, ogDescription } = Astro.props;
const feedLink = '/feed.xml';
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content={description}>
<title>{title}</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="alternate" type="application/atom+xml" title="The Future Is Solo" href={feedLink}>
<meta property="og:title" content={ogTitle ?? title}>
<meta property="og:description" content={ogDescription ?? description}>
<meta property="og:type" content={ogType}>
<meta name="twitter:card" content="summary_large_image">
<link rel="stylesheet" href="/shared.css">
<script>(function(){var s=localStorage.getItem('tfis-theme')||(matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');document.documentElement.setAttribute('data-theme',s)})()</script>
<script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "YOUR_CLOUDFLARE_TOKEN"}'></script>
</head>
<body data-page={page}>
<a href="#main-content" class="skip-link">Skip to main content</a>

<nav id="topNav">
  <a href="/" class="logo"><em>TFIS</em></a>
  <div class="nav-right">
    {page === 'home' ? (
      <a href="#" onclick="scrollToSection('ladder');return false" style="color:var(--accent)">Assess Your Level</a>
    ) : (
      <a href="/">Home</a>
    )}
    <a href="/functional-life.html">Functional Life</a>
    <a href="/meaning-of-life.html">Meaning of Life</a>
    <a href="https://mesolitica.thinkific.com/products/digital_downloads/tfis-whitepaper?utm_source=tfis&amp;utm_medium=site&amp;utm_campaign=ssa-assessment&amp;utm_content=whitepaper" target="_blank" rel="noopener" class="nav-btn">Whitepaper →</a>
    <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode"></button>
    <button class="nav-toggle" id="navToggle" aria-label="Menu">☰</button>
  </div>
</nav>

<div class="nav-overlay" id="navOverlay">
  <a href="/">← Home</a>
  <a href="/functional-life.html">The Functional Life</a>
  <a href="/meaning-of-life.html">The Meaning of Life</a>
  <a href="https://mesolitica.thinkific.com/products/digital_downloads/tfis-whitepaper?utm_source=tfis&amp;utm_medium=site&amp;utm_campaign=ssa-assessment&amp;utm_content=whitepaper" target="_blank" rel="noopener">Download Whitepaper →</a>
</div>

<main id="main-content">
  <slot />
</main>

<footer>
  <div class="container">
    <div class="f-inner">
      <span class="f-copy">TFIS · The Future Is Solo</span>
      <div class="f-links">
        <a href="/">Home</a>
        <a href="/functional-life.html">Functional Life</a>
        <a href="/meaning-of-life.html">Meaning of Life</a>
        <a href="mailto:khalil@mesolitica.com">Contact</a>
      </div>
      <span class="f-copy">© 2026 · Khalil Nooh</span>
    </div>
    <form class="subscribe-form" action="/api/subscribe" method="post">
      <label for="sub-email" class="subscribe-label">Subscribe for updates</label>
      <div class="subscribe-row">
        <input type="email" name="email" id="sub-email" class="subscribe-input" placeholder="your@email.com" required>
        <button type="submit" class="btn btn--accent btn--small">Subscribe</button>
      </div>
    </form>
    <div class="f-cta">
      <a href="/#ladder">Assess your SSA Level</a>
      <span style="margin:0 8px">·</span>
      <a href="https://mesolitica.thinkific.com/products/digital_downloads/tfis-whitepaper?utm_source=tfis&amp;utm_medium=site&amp;utm_campaign=ssa-assessment&amp;utm_content=whitepaper" target="_blank" rel="noopener">Download Whitepaper ↗</a>
      <span style="margin:0 8px">·</span>
      <a href="https://mesolitica.thinkific.com?utm_source=tfis&amp;utm_medium=site&amp;utm_campaign=ssa-assessment&amp;utm_content=course" target="_blank" rel="noopener">AI Fluency Course ↗</a>
      <span style="margin:0 8px">·</span>
      <a href="/feed.xml" target="_blank" rel="noopener">RSS Feed ↗</a>
    </div>
  </div>
</footer>

<script is:inline src="/shared.js"></script>
</body>
</html>
